params {
  project_folder   = "$PWD"
  samplesheet      = null
  samples_master   = null
  chipfilter_output = null
  macs3_output     = null
  diffbind_macs3_profile = "strict_q0.01"
  diffbind_peak_ext = "narrowPeak"
  diffbind_output  = "diffbind_output"

  container_diffbind = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/diffbind-3.12.0.sif"
  extra_mounts = ''
  mail_user = 'molendo.hpc@gmail.com'

  diffbind_cpus   = 4
  diffbind_memory = '64 GB'
  diffbind_time   = '24h'
  diff_fdr        = 0.05
  diff_lfc        = 1
}

process {
  executor = 'local'
}

profiles {
  local { includeConfig 'configs/local.config' }
  hpc   { includeConfig 'configs/slurm.config' }
}
